# ==============================================================================
# RiskGraph Platform — Production Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to '.env.production' on your Oracle Cloud VM:
#      cp .env.production.example .env.production
# 2. Update the passwords and secrets below with secure random values.
# 3. DO NOT commit '.env.production' to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=8000

# --- Public Host / IP ---
# Set your Oracle Cloud VM Public IP or Custom Domain name
PUBLIC_HOST=your-vm-public-ip-or-domain

# --- Relational Database (PostgreSQL) ---
POSTGRES_USER=riskgraph_user
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=riskgraph
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Graph Database (Neo4j) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=generate_a_strong_neo4j_password_here
NEO4J_URI=bolt://neo4j:7687

# --- In-Memory Velocity & Blacklist Store (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Messaging & Streaming Backbone (Apache Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_RAW_TRANSACTIONS_TOPIC=fraud.transactions.raw
KAFKA_RAW_IDENTITY_TOPIC=fraud.identity.raw
KAFKA_ALERTS_TOPIC=fraud.alerts
KAFKA_DLQ_TOPIC=fraud.dlq
KAFKA_CONSUMER_GROUP=riskgraph-streaming-group

# --- Object Storage (LocalStack S3) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localstack:4566
S3_BUCKET_NAME=riskgraph-lake

# --- Spark Processing ---
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# --- Pipeline Orchestration (Apache Airflow) ---
AIRFLOW_URL=http://airflow:8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_production_pass

# --- Observability (Grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_observability_pass
